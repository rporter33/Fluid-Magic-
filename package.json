{
  "name": "fluid-magic",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-based grand strategy with a five-color magic system.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sim.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "sim:aivai": "tsx scripts/aivai.ts",
    "sim:duel": "tsx scripts/duel.ts",
    "golden:battle": "tsx scripts/golden-battle.ts"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "idb-keyval": "^6.3.0",
    "pixi.js": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
