 "meta": {
  "app": "stage D rest: dd_fx_pack.py (new effect sheets beside the pilot's atlas/fx)",
  "image": "fx2-atlas.png",
  "size": {
   "w": 2048,
   "h": 2048
  },
  "format": "RGBA8888",
  "scale": 1,
  "fill": 0.558,
  "fireAlphaBoost": 1.7,
  "fireSheets": [
   "E1",
   "E7c"
  ],
  "lightSheets (additive, no boost)": [
   "G1s",
   "H1",
   "V1"
  ],
  "picks": {
   "E1": {
    "candidate": "a",
    "file": "stage-d/raw/E1.a.nb21.json",
    "sha256": "803e36bb4642bac1280552c5692e29ac1e2f811449241c59cc0673f4583d3919",
    "title": "flame tongues",
    "blend": "add",
    "why": "a: three clean painted loops; b left the grey placeholders showing under its flames"
   },
   "E7c": {
    "candidate": "b",
    "file": "stage-d/raw/E7c.b.g3pro.json",
    "sha256": "aac71b7a5f2016010e372ee0038145b8c1c888e2a3b6b6de4b0cf255e3887979",
    "title": "fire breath core",
    "blend": "add",
    "why": "b: a fierce white-gold jet that sits inside the billows; a is a whole flame stream of its own, too wide for a core"
   },
   "E7b": {
    "candidate": "r2",
    "file": "stage-d/raw/E7b.r2.g3pro.json",
    "sha256": "766f08e202fda61edd31cc0eb20c5301f3c99b93a24d791edb957392efdedf7e",
    "title": "fire breath billows",
    "blend": "normal",
    "why": "r2 (one re-roll, g3pro with b as reference): rolling flame and soot billows that end in rounded puffs inside their cells; a copied the guide's hard dark wedge, b painted the guide's flat far end and two of its frames met the sheet edge"
   },
   "L5": {
    "candidate": "a",
    "file": "stage-d/raw/L5.a.nb21.json",
    "sha256": "7d2f5cf2be95bc8f546f4b2992da4dc106dbbf304c2be3e87bf622e236d53f65",
    "title": "bark plating",
    "blend": "opaque",
    "why": "a: even ridged bark that tiles (seam step 4.7 against 4.1 inside); b has one large pale ridge that repeats visibly"
   },
   "L6g": {
    "candidate": "b",
    "file": "stage-d/raw/L6g.b.g3pro.json",
    "sha256": "76b40578efaabcc040f50e507d01fea39d0ff65e945d94ad709f29981a55acef",
    "title": "loam breath gale",
    "blend": "normal",
    "why": "b: large readable burrs, seed pods and torn leaves; a's twigs and seeds are too small to read at play zoom"
   },
   "L6s": {
    "candidate": "a",
    "file": "stage-d/raw/L6s.a.nb21.json",
    "sha256": "34b6df02581ef5543cd9081ba9f64d0bb63b7dab6c3f0f90a791af5d9c21dd08",
    "title": "loam breath spores",
    "blend": "luma",
    "why": "a: the haze grows from the jaws like the gale; b's clouds start mid-cell and do not line up with the gale"
   },
   "H1": {
    "candidate": "a",
    "file": "stage-d/raw/H1.a.nb21.json",
    "sha256": "e475a202f7d633775b19a59d2440b889bb43c59ddfc567c82397b2518f627464",
    "title": "holy light",
    "blend": "add",
    "why": "a: all four elements fill their boxes (the halo ring at full size); b's halo ring is a third too small"
   },
   "G1s": {
    "candidate": "a",
    "file": "stage-d/raw/G1s.a.nb21.json",
    "sha256": "ae80b18cff8d4de1bd15884c4b089d0db2735d22d8a497615eb49c27d41ca920",
    "title": "sun mana ring and glyph",
    "blend": "add",
    "why": "a: a filled sun disc with eight rays, the game's Radiance symbol, reads at 20 px; b's hollow outline thins away"
   },
   "U1": {
    "candidate": "a",
    "file": "stage-d/raw/U1.a.nb21.json",
    "sha256": "96e9620e1de29dd0c4930c6acf90134dc984da4dcca4c8ccf0a710e8ed94bfec",
    "title": "umbra",
    "blend": "multiply",
    "why": "a: painterly ink and smoke in the decals' hand; b is smoother and tinted violet"
   },
   "V1": {
    "candidate": "a",
    "file": "stage-d/raw/V1.a.nb21.json",
    "sha256": "3927d8cef93a5698d1fd79ecc787bf9317df915715df6d7e931225a2d9153e13",
    "title": "veins",
    "blend": "add",
    "why": "a: soft glowing veins; b is crisp white branching that reads as trees"
   }
